# Mealzy Telegram Bot — Environment Variables
# Copy this to .env and fill in your values

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Groq API Key
GROQ_API_KEY=your_groq_api_key_here

# Groq Model (default: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# Bot personality name (the human name the bot uses)
BOT_NAME=Priya

# Optional: Telegram Chat ID to forward completed onboarding data to
# FORWARD_CHAT_ID=your_chat_id_here
