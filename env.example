# Mealzy Telegram Onboarding Bot — Environment Variables
#
# FOR LOCAL DEV: copy this file to ".env" and fill in your values.
# FOR RAILWAY:   set these in the Railway dashboard → Variables tab.
#                Do NOT commit your real .env file to GitHub.
# ──────────────────────────────────────────────────────────────────

# Telegram Bot Token — get from @BotFather on Telegram (required)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Groq API Key — get from console.groq.com (required)
GROQ_API_KEY=your_groq_api_key_here

# Groq Model (optional — defaults to llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.3-70b-versatile

# Bot personality name — the human name shown to clients (optional, default: Priya)
# BOT_NAME=Priya

# Telegram Chat ID to receive completed onboarding summaries + body photos (optional but recommended)
# To find your Chat ID: message @userinfobot on Telegram
# ADMIN_CHAT_ID=your_chat_id_here
